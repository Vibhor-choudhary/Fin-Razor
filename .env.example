# =============================================================================
# Checkout Recovery Agent — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# =============================================================================

# Hyperswitch sandbox secret key (prefix: snd_)
HYPERSWITCH_API_KEY_TEST=

# Upsonic agent API key (from https://docs.upsonic.ai)
UPSONIC_API_KEY=

# Sentry DSN for structured logging
# Format: https://<key>@o<org>.ingest.sentry.io/<project-id>
SENTRY_DSN=

# Python environment: "development" | "test" | "production"
APP_ENV=development

# Backend API URL exposed to the frontend (Vite)
# Local: http://localhost:8000
# Vercel: https://<your-app>.vercel.app
VITE_API_URL=http://localhost:8000

# Database connection string
# SQLite (local): sqlite:///./dev.db
# Vercel Postgres: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./dev.db

# Port for the FastAPI backend service (local only)
PORT=8000

# LLM provider key — powers the agent's detect/decide calls
# Free tier: Google AI Studio (aistudio.google.com) → create API key
GOOGLE_API_KEY=

# Optional fallback provider (free tier: console.groq.com)
GROQ_API_KEY=

# Agent model string
AGENT_MODEL=groq/openai/gpt-oss-120b
