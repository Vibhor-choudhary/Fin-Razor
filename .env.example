# =============================================================================
# Checkout Recovery Agent — Environment Configuration Template
# Copy this file to .env for local configuration. Never commit .env to git.
# =============================================================================

# Deployment Environment Mode
# Set to "development" for local controlled sandbox (enables local payment execution in Lab).
# Set to "demo_readonly" for public production deployments (enforces read-only safety, blocks Lab runs).
APP_ENV=

# CORS Allowed Origins (comma-separated URLs, no wildcards in production)
# Example (Local): http://localhost:5173,http://localhost:3000
# Example (Production): https://your-frontend.vercel.app
CORS_ORIGINS=

# Database Connection String
# Example (Local): sqlite:///./dev.db
# Example (Render / Hosted Postgres): postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Hyperswitch Sandbox Secret Key (Local sandbox execution only)
# Required ONLY when running controlled payment scenarios locally (APP_ENV=development).
# DO NOT configure or provide on public read-only deployments.
HYPERSWITCH_API_KEY_TEST=

# Hyperswitch Base URL (Optional, defaults to https://sandbox.hyperswitch.io)
HYPERSWITCH_BASE_URL=

# Frontend Public API Base URL (Vite environment variable for deployed builds)
# Example (Local): http://localhost:8000
# Example (Vercel): https://your-backend.onrender.com
VITE_API_URL=

# Observability (Optional)
# Sentry DSN for structured error logging
SENTRY_DSN=

# LLM Agent Provider Keys (Optional for local agent decision evaluations)
GOOGLE_API_KEY=
GROQ_API_KEY=
UPSONIC_API_KEY=
AGENT_MODEL=
